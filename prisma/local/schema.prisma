// Checkin Pocket — banco LOCAL (SQLite, modo WAL habilitado em runtime via PRAGMA).
// Este schema é independente do schema principal (prisma/schema.prisma), que
// continua apontando para o MySQL compartilhado usado pelo fluxo legado do
// Printer Hub (polling/lease via HTTP contra o Checkin Pai).
//
// Gere o client com:
//   npx prisma generate --config prisma.local.config.ts
//
// Aplique as migrations com:
//   npx prisma migrate deploy --config prisma.local.config.ts

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-local"
}

datasource db {
  provider = "sqlite"
}

/// Réplica local do ingresso (Student) do Checkin Pai, usada para localizar
/// o aluno pelo token do QR Code sem depender de rede durante o check-in —
/// e também por nome/e-mail/documento, para quando o operador não tem o
/// voucher em mãos (ver StudentsService#search).
model Student {
  id            Int       @id
  courseId      Int       @map("course_id")
  courseName    String    @map("course_name")
  /// Data de início da turma no Checkin Pai (formato "YYYY-MM-DD",
  /// denormalizada do Course — usada para bloquear check-in fora do
  /// período do evento, ver CheckinService#validateCourseWindow).
  courseEventDate    String?   @map("course_event_date")
  /// Data de término da turma (mesmo formato de courseEventDate).
  courseEventDateEnd String?   @map("course_event_date_end")
  /// Tipo da turma no Checkin Pai (`Course.event_type`: "event" ou "formation"),
  /// denormalizado para restringir o que cada operador enxerga (espelha a
  /// CoursePolicy::Scope do Pai). Nulo em registros antigos até o próximo
  /// download da turma — operador restrito NÃO enxerga alunos sem tipo.
  courseEventType    String?   @map("course_event_type")
  /// Cidade do evento (ex.: "Goiânia - GO"), lida do banco do IBC (ces.cidade)
  /// no download da turma e impressa na etiqueta. Nulo se a consulta falhou ou
  /// a turma ainda não foi baixada desde que o campo existe — a etiqueta sai
  /// sem a linha da cidade.
  courseCity         String?   @map("course_city")
  name          String
  email         String?
  document      String?
  token         String    @unique
  ibcCustomerId Int?      @map("ibc_customer_id")
  /// Já teve ao menos uma presença registrada (qualquer dia do evento).
  checkedIn     Boolean   @default(false) @map("checked_in")
  /// Instante da presença MAIS RECENTE — evento de vários dias gera uma
  /// presença por dia (espelha as DailyPresence do Checkin Pai). É por ele que
  /// se sabe se o aluno já foi credenciado HOJE.
  checkedInAt   DateTime? @map("checked_in_at")
  /// A etiqueta já foi enviada para impressão (espelha `tag_printer` do Pai).
  /// Só imprime enquanto false; nos demais dias apenas a presença é registrada.
  labelPrinted  Boolean   @default(false) @map("label_printed")
  syncedAt     DateTime  @default(now()) @map("synced_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  printJobs PrintJob[]

  @@index([checkedIn])
  @@index([name])
  @@index([email])
  @@index([document])
  @@map("students")
}

/// Representa este agente/estação de credenciamento local (a própria
/// instância do Checkin Pocket). Diferente do fluxo antigo, não há mais
/// leasing remoto de jobs: a impressão acontece diretamente nesta máquina.
model PrinterAgent {
  id           Int      @id @default(autoincrement())
  agentKey     String   @unique @map("agent_key")
  name         String
  status       String   @default("online")
  version      String?
  metadataJson String?  @map("metadata_json")
  lastSeenAt   DateTime @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  printers         Printer[]
  printJobAttempts PrintJobAttempt[]

  @@map("printer_agents")
}

/// Impressoras físicas detectadas nesta estação.
model Printer {
  id             Int      @id @default(autoincrement())
  printerAgentId Int?     @map("printer_agent_id")
  printerUid     String   @unique @map("printer_uid")
  name           String
  isDefault      Boolean  @default(false) @map("is_default")
  isOnline       Boolean  @default(true) @map("is_online")
  lastSeenAt     DateTime @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  printerAgent PrinterAgent? @relation(fields: [printerAgentId], references: [id])

  @@map("printers")
}

/// Trabalho de impressão da etiqueta de credenciamento, criado
/// imediatamente após o check-in e processado por um worker local.
model PrintJob {
  id               Int    @id @default(autoincrement())
  studentId        Int?   @map("student_id")
  courseId         Int?   @map("course_id")
  targetPrinterUid String @map("target_printer_uid")
  labelName        String @map("label_name")
  labelCourseName  String @map("label_course_name")
  /// Token do aluno (conteúdo do QR Code da etiqueta) e cidade do evento,
  /// congelados na criação do job — retry/reimpressão não muda a etiqueta.
  labelToken       String? @map("label_token")
  labelCity        String? @map("label_city")
  mode             String @default("local")
  priority         Int    @default(0)
  status           String @default("pending") // pending | succeeded | dead
  attemptCount     Int    @default(0) @map("attempt_count")
  maxAttempts      Int    @default(3) @map("max_attempts")
  idempotencyKey   String @unique @map("idempotency_key")
  resultJson       String? @map("result_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student  Student?          @relation(fields: [studentId], references: [id])
  attempts PrintJobAttempt[]

  @@index([status, priority, createdAt])
  @@map("print_jobs")
}

/// Histórico de tentativas de impressão de um print_job (sucesso ou falha).
model PrintJobAttempt {
  id             Int       @id @default(autoincrement())
  printJobId     Int       @map("print_job_id")
  printerAgentId Int?      @map("printer_agent_id")
  startedAt      DateTime  @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  success        Boolean   @default(false)
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  printJob     PrintJob      @relation(fields: [printJobId], references: [id])
  printerAgent PrinterAgent? @relation(fields: [printerAgentId], references: [id])

  @@map("print_job_attempts")
}

/// Cache local de operadores (usuários do Checkin Pai) usado para login
/// offline/local nesta estação. Populado e mantido em dia pelo
/// AuthSyncService, que sincroniza a partir do banco do Pai (MySQL) no
/// boot (retry até conseguir) e depois periodicamente.
///
/// `passwordHash` é o hash bcrypt padrão (`encrypted_password`) gerado pelo
/// Devise no Checkin Pai — o login local faz bcrypt.compare contra este
/// valor, sem depender de rede após a primeira sincronização bem-sucedida.
model Operator {
  id                  Int      @id @default(autoincrement())
  remoteUserId        Int      @unique @map("remote_user_id")
  email               String   @unique
  passwordHash        String   @map("password_hash")
  name                String
  /// Espelha o enum `status` do Checkin Pai: manager=0, admin=1, staff=2, user=3.
  status              Int      @default(3)
  /// Espelha o enum `course_type` do Checkin Pai: full=0, formation=1, event=2.
  courseType          Int      @default(0) @map("course_type")
  authenticationToken String?  @map("authentication_token")
  /// Último momento em que este registro foi atualizado a partir do Pai.
  syncedAt            DateTime @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("operators")
}

/// Transferência de ingresso solicitada pelo operador nesta estação.
/// Criada com status "pending" na MESMA transação SQLite que grava o
/// OutboxEvent de `transfer.requested` — o resultado (sucesso/erro) só
/// chega depois, de forma assíncrona, via TicketTransferSyncConsumer
/// (evento `transfer.completed` publicado pelo Checkin Pai). O front
/// usa este registro para fazer polling do status sem travar a tela
/// enquanto o Pai processa a transferência no Coliseum.
model TicketTransfer {
  id                String    @id @default(uuid())
  studentId         Int       @map("student_id")
  courseId          Int       @map("course_id")
  status            String    @default("pending") // pending | completed | failed
  requestedName     String    @map("requested_name")
  requestedEmail    String    @map("requested_email")
  requestedPhone    String    @map("requested_phone")
  requestedDocument String?   @map("requested_document")
  requestedNickName String?   @map("requested_nick_name")
  requestedNote     String?   @map("requested_note")
  errorMessage      String?   @map("error_message")
  sourceAgentKey    String    @map("source_agent_key")
  resolvedAt        DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([studentId])
  @@map("ticket_transfers")
}

/// Outbox Pattern: eventos de domínio (ex.: check-in realizado) gravados na
/// MESMA transação local que a mudança de estado. Um worker tenta publicar
/// no RabbitMQ e só apaga a linha após receber o ACK do broker.
model OutboxEvent {
  id            String @id @default(uuid())
  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  eventType     String @map("event_type")
  routingKey    String @map("routing_key")
  payload       String // JSON serializado (string) — evita depender de suporte a Json nativo do driver.
  status        String @default("pending") // pending | failed
  attempts      Int    @default(0)
  lastError     String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

/// Cadastro manual de aluno feito NESTA estação (equivalente ao formulário
/// de cortesia do Checkin Pai). O `Student` local nasce com id provisório
/// NEGATIVO e o mesmo `token` que o Pai vai usar; o `student.create.completed`
/// do Pai troca o id pelo definitivo. Só existe na estação que originou o
/// cadastro — serve para rastrear o resultado assíncrono (pending/completed/failed).
model StudentRegistration {
  id                String    @id @default(uuid())
  /// Token do voucher gerado pelo Pocket (UUID); o Pai o reaproveita — o QR impresso continua válido.
  token             String    @unique
  courseId          Int       @map("course_id")
  /// ID local (provisório, negativo) do Student criado na estação.
  localStudentId    Int       @map("local_student_id")
  /// ID definitivo do Student no Checkin Pai, preenchido na confirmação.
  paiStudentId      Int?      @map("pai_student_id")
  status            String    @default("pending") // pending | completed | failed
  name              String
  nickName          String    @map("nick_name")
  document          String
  email             String
  phone             String?
  ownerName         String?   @map("owner_name")
  ownerDocument     String?   @map("owner_document")
  note              String?
  errorMessage      String?   @map("error_message")
  sourceAgentKey    String    @map("source_agent_key")
  resolvedAt        DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("student_registrations")
}
