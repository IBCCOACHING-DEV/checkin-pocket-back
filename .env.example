NODE_ENV=development
PORT=3000

JWT_SECRET=
JWT_EXPIRES_IN=24h

DEFAULT_PRINTER=
PRINT_TIMEOUT=

# Experimental (Windows apenas): pula a renderização GDI/driver e envia o
# protocolo raster nativo da Brother QL-810W direto pra fila de impressão
# como datatype RAW. Reduz o tempo entre o check-in e o barulho da
# impressora (~1.2-1.3s a menos, medido nesta sessão). Ativar só depois de
# validar fisicamente nesta estação — ver CLAUDE.md §5.
PRINT_USE_RAW_RASTER=false

# Origem do front-end (checkin-pocket-front, Vite) em desenvolvimento.
# Separe múltiplas origens por vírgula.
ALLOWED_ORIGINS=http://localhost:5173

# ==============================================================
# Checkin Pocket — banco local (SQLite/WAL) e mensageria (RabbitMQ)
# ==============================================================
LOCAL_DATABASE_URL=file:./data/checkin-pocket.db
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Identidade desta estação (deve ser única por computador da rede)
CHECKIN_AGENT_KEY=agent-notebook-a
CHECKIN_AGENT_NAME=Notebook Credenciamento A

# ==============================================================
# Checkin Pai — banco MySQL principal ("checkin"), acesso SOMENTE LEITURA.
# Usado para sincronizar autenticação (users) e listar/baixar
# Courses/Students sob demanda (telas "Login" e "Baixar turma").
# ==============================================================
PAI_DATABASE_HOST=
PAI_DATABASE_PORT=3306
PAI_DATABASE_NAME=checkin
PAI_DATABASE_USER=
PAI_DATABASE_PASSWORD=
# Banco do sistema IBC (turmas/ces) no MESMO servidor MySQL acima — lido só
# para imprimir a cidade do evento na etiqueta. Opcional (padrão abaixo); o
# usuário precisa de SELECT em turmas e ces, senão a etiqueta sai sem cidade.
PAI_IBC_DATABASE_NAME=ibcsystem_production
# Usada somente por "npx prisma generate --config prisma.remote.config.ts"
PAI_DATABASE_URL=mysql://user:password@host:3306/checkin

# Loop de sincronização de auth: intervalo de retry até conseguir a
# primeira sincronização e intervalo de refresh periódico depois disso.
AUTH_SYNC_RETRY_INTERVAL_MS=15000
AUTH_SYNC_REFRESH_INTERVAL_MS=300000