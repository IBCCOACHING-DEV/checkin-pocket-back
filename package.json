{
  "name": "ibc-printer",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "dev": "npm run start:dev",
    "build": "nest build",
    "build:win": "nest build && cp package.json dist/ && cp .env dist/",
    "test:api": "npm run build && npm run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --silent",
    "test:watch": "jest --watch --silent",
    "test:cov": "jest --coverage --silent",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --silent",
    "test:e2e": "jest --config ./test/jest-e2e.json --silent",
    "test:unit": "jest src/ --silent",
    "test:integration": "jest --config ./test/jest-e2e.json --silent",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --silent --runInBand",
    "token": "node scripts/generate-test-token.js",
    "reset-checkin": "ts-node -r tsconfig-paths/register scripts/reset-checkin.ts",
    "prisma:local:generate": "prisma generate --config prisma.local.config.ts",
    "prisma:local:migrate": "prisma migrate deploy --config prisma.local.config.ts",
    "prisma:local:migrate:dev": "prisma migrate dev --config prisma.local.config.ts",
    "prisma:remote:generate": "prisma generate --config prisma.remote.config.ts",
    "prisma:generate": "npm run prisma:local:generate && npm run prisma:remote:generate",
    "postinstall": "npm run prisma:generate || echo 'AVISO: prisma generate falhou no postinstall (normal se o .env ainda nao existir/estiver incompleto). Depois de configurar o .env, rode: npm run prisma:generate'"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.1.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.1.1",
    "helmet": "^7.0.0",
    "mariadb": "^3.5.3",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pdfkit": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "temp": "^0.9.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^3.0.9",
    "@types/pdfkit": "^0.12.9",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "optionalDependencies": {
    "node-printer": "^1.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapping": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/../test/setup.ts"
    ],
    "moduleNameMapper": {
      "^node-printer$": "<rootDir>/../test/mocks/node-printer.ts"
    }
  }
}
